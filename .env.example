# Direct DeepSeek, selected after Gemini HTTP 429 (user-authorized change).
# Copy to .env, fill the key locally; never commit .env.
# The openai label selects the existing compatible-format adapter.
PROVIDER=openai
MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# Run: python with_env.py evals/run_evals.py --output eval_before.json
# For this machine: python with_env.py --env .local/deepseek.env run.py "Your question"
